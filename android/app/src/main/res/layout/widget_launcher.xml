<?xml version="1.0" encoding="utf-8"?>
<!-- Widget « Lanceur Lielu » : un simple bouton discret ; un appui déploie les apps. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/launcher_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/launcher_button"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="center"
        android:background="@drawable/widget_launcher_background"
        android:contentDescription="@string/launcher_widget_button"
        android:padding="12dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_widget_launcher" />
</FrameLayout>
